rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ijishnusuresh@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && !('banned' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned']);
      allow write: if isAdmin();
    }
    match /profiles/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /history/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /reqs/{id} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow read: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || isAdmin());
      allow update: if request.auth != null && resource.data.to == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    match /invites/{id} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow read: if request.auth != null && (resource.data.to == request.auth.uid || isAdmin());
      allow delete: if request.auth != null && resource.data.to == request.auth.uid;
    }
    match /rooms/{code} {
      allow read: if isAdmin();
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }
    match /reports/{id} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow read, delete: if isAdmin();
    }
    match /suggestions/{id} {
      allow create: if request.resource.data.text is string && request.resource.data.text.size() <= 600;
      allow read, delete: if isAdmin();
    }
    match /groups/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['code','name','host','count','max','ph','ts'])
                            && request.resource.data.name is string
                            && request.resource.data.name.size() <= 24;
      allow delete: if true;
    }
  }
}
